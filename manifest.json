{
  "manifest_version": 3,
  "name": "PrivacyGuard - Sözleşme Risk Analizi",
  "version": "1.0.0",
  "description": "Web sayfasındaki gizlilik politikası / kullanım şartlarını otomatik tarar, risk skoru ve kritik maddeleri özetler.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
